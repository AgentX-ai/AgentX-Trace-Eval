{
  "name": "@agentx/engine",
  "version": "0.1.0",
  "private": true,
  "description": "AgentX self-host governance engine: Evaluate, Monitor, and Trace as a local HTTP API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "compile": "bun build src/index.ts --compile --outfile dist/agentx-engine",
    "db:migrate": "tsx --env-file-if-exists=.env src/storage/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@agentx/judge-core": "*",
    "@anthropic-ai/sdk": "^0.27.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.6.29",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "nanoid": "^5.0.7",
    "openai": "^4.58.1",
    "pg": "^8.12.0",
    "protobufjs": "^8.7.1",
    "umap-js": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "bun-types": "^1.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.5"
  }
}
