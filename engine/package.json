{
  "name": "@agentx/engine",
  "version": "0.2.0",
  "private": true,
  "description": "AgentX self-host governance engine: Evaluate, Monitor, and Trace as a local HTTP API.",
  "type": "module",
  "scripts": {
    "predev": "yarn workspace @agentx/judge-core build",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts < /dev/null",
    "prebuild": "yarn workspace @agentx/judge-core build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "compile": "bun build src/index.ts --compile --outfile dist/agentx-engine",
    "db:migrate": "tsx --env-file-if-exists=.env src/storage/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test:coverage": "c8 --temp-directory .c8-tmp --include 'src/**' --exclude 'src/test/**' --exclude '**/*.test.ts' -r text-summary --check-coverage --lines 40 --statements 40 --functions 25 --branches 50 vitest run"
  },
  "dependencies": {
    "@agentx/judge-core": "*",
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "nanoid": "^5.0.7",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "protobufjs": "^8.7.2",
    "re2js": "^2.8.6",
    "umap-js": "^1.4.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
