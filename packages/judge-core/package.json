{
  "name": "@agentx/judge-core",
  "version": "0.1.4",
  "description": "LLM-as-judge prompt template + multi-provider (OpenAI/Anthropic) scoring call, shared between AgentX-web-api and AgentX-trace-eval's engine so the two don't maintain separate copies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.24",
    "openai": ">=4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@types/node": "^22.5.0",
    "openai": "^4.58.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
