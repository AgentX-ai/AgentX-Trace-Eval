{
  "name": "@agentx/judge-core",
  "version": "0.1.17",
  "description": "LLM-as-judge prompt template + multi-provider (OpenAI/Anthropic) scoring call, shared between AgentX-web-api and AgentX-trace-eval's engine so the two don't maintain separate copies.",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationDir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.24",
    "openai": ">=4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@types/node": "^24.13.3",
    "openai": "^7.8.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.5"
  }
}
